{
    "src/*.{js,jsx,ts,tsx}": ["prettier --cache --ignore-unknown  --write", "eslint --cache --fix --max-warnings 0 "],
    "package.json": ["prettier --cache --write"],
    "*.vue": ["prettier --write", "eslint --cache --fix", "stylelint --fix --allow-empty-input"],
    "*.{css,scss,html}": ["prettier --cache --ignore-unknown --write", "stylelint --fix --allow-empty-input"]
}
